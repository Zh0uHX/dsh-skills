{
  "name": "dsh-skills",
  "version": "0.1.0",
  "description": "Skills.sh skill management inside DeepSeek Harness settings",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zh0uHX/dsh-skills.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/index.cjs",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-fs": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-fs-local": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.7-alpha.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "tsx": "^4.0.0",
    "typescript": "7.0.2"
  },
  "main": "./lib/index.cjs"
}
